{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "{{env.CLOUDBASE_ENV_ID}}",
  "functionRoot": "functions",
  "functions": [
    {
      "name": "app-api",
      "type": "HTTP",
      "public": true,
      "gatewayPath": "/api/v1",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 30,
      "memorySize": 256,
      "description": "利韩土豆仓模块化 API 内核",
      "installDependency": true,
      "envVariables": {
        "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}",
        "COS_PUBLIC_BUCKET": "{{env.COS_PUBLIC_BUCKET}}",
        "COS_PRIVATE_BUCKET": "{{env.COS_PRIVATE_BUCKET}}",
        "COS_REGION": "{{env.COS_REGION}}",
        "DATABASE_SCHEMA": "{{env.DATABASE_SCHEMA}}",
        "API_ALLOWED_ORIGINS": "{{env.API_ALLOWED_ORIGINS}}",
        "SESSION_HASH_PEPPER": "{{env.SESSION_HASH_PEPPER}}",
        "AUTH_HASH_PEPPER": "{{env.AUTH_HASH_PEPPER}}",
        "MIGRATION_HASH_PEPPER": "{{env.MIGRATION_HASH_PEPPER}}",
        "RATE_LIMIT_PEPPER": "{{env.RATE_LIMIT_PEPPER}}",
        "SESSION_COOKIE_DOMAIN": "{{env.SESSION_COOKIE_DOMAIN}}",
        "SESSION_COOKIE_NAME": "{{env.SESSION_COOKIE_NAME}}",
        "CSRF_COOKIE_NAME": "{{env.CSRF_COOKIE_NAME}}",
        "MIGRATION_COOKIE_NAME": "{{env.MIGRATION_COOKIE_NAME}}",
        "API_BODY_LIMIT_BYTES": "{{env.API_BODY_LIMIT_BYTES}}",
        "CSRF_REQUIRED": "{{env.CSRF_REQUIRED}}",
        "TRUST_PROXY_HEADERS": "{{env.TRUST_PROXY_HEADERS}}",
        "API_PROXY_HMAC_SECRET": "{{env.API_PROXY_HMAC_SECRET}}",
        "LEGACY_MIGRATION_ENABLED": "{{env.LEGACY_MIGRATION_ENABLED}}",
        "SNAPSHOT_SYSTEM_ACTOR_ID": "{{env.SNAPSHOT_SYSTEM_ACTOR_ID}}"
      }
    },
    {
      "name": "snapshot-worker",
      "type": "Event",
      "dir": "app-api",
      "runtime": "Nodejs18.15",
      "handler": "snapshot-worker.main",
      "timeout": 60,
      "memorySize": 256,
      "description": "Rebuilds recoverable public snapshots from queued database jobs",
      "installDependency": true,
      "triggers": [
        { "name": "catalog-snapshot-every-5m", "type": "timer", "config": "0 */5 * * * * *" }
      ],
      "envVariables": {
        "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}",
        "COS_PUBLIC_BUCKET": "{{env.COS_PUBLIC_BUCKET}}",
        "COS_PRIVATE_BUCKET": "{{env.COS_PRIVATE_BUCKET}}",
        "COS_REGION": "{{env.COS_REGION}}",
        "DATABASE_SCHEMA": "{{env.DATABASE_SCHEMA}}",
        "API_ALLOWED_ORIGINS": "{{env.API_ALLOWED_ORIGINS}}",
        "SESSION_HASH_PEPPER": "{{env.SESSION_HASH_PEPPER}}",
        "AUTH_HASH_PEPPER": "{{env.AUTH_HASH_PEPPER}}",
        "RATE_LIMIT_PEPPER": "{{env.RATE_LIMIT_PEPPER}}",
        "SESSION_COOKIE_DOMAIN": "{{env.SESSION_COOKIE_DOMAIN}}",
        "SNAPSHOT_SYSTEM_ACTOR_ID": "{{env.SNAPSHOT_SYSTEM_ACTOR_ID}}"
      }
    },
    {
      "name": "upload-cleanup-worker",
      "type": "Event",
      "dir": "app-api",
      "runtime": "Nodejs18.15",
      "handler": "upload-cleanup-worker.main",
      "timeout": 60,
      "memorySize": 256,
      "description": "Cleans stale fenced upload promotions independently of snapshot delivery",
      "installDependency": true,
      "triggers": [
        { "name": "upload-cleanup-every-10m", "type": "timer", "config": "0 */10 * * * * *" }
      ],
      "envVariables": {
        "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}",
        "COS_PUBLIC_BUCKET": "{{env.COS_PUBLIC_BUCKET}}",
        "COS_PRIVATE_BUCKET": "{{env.COS_PRIVATE_BUCKET}}",
        "COS_REGION": "{{env.COS_REGION}}",
        "DATABASE_SCHEMA": "{{env.DATABASE_SCHEMA}}",
        "API_ALLOWED_ORIGINS": "{{env.API_ALLOWED_ORIGINS}}",
        "SESSION_HASH_PEPPER": "{{env.SESSION_HASH_PEPPER}}",
        "AUTH_HASH_PEPPER": "{{env.AUTH_HASH_PEPPER}}",
        "RATE_LIMIT_PEPPER": "{{env.RATE_LIMIT_PEPPER}}",
        "SESSION_COOKIE_DOMAIN": "{{env.SESSION_COOKIE_DOMAIN}}",
        "SNAPSHOT_SYSTEM_ACTOR_ID": "{{env.SNAPSHOT_SYSTEM_ACTOR_ID}}"
      }
    }
  ]
}
