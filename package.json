{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "sprites": "python3 scripts/generate-ui-sprite.py",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:save-hange": "vite --config vite.save-hange.config.ts --port=3001",
    "build": "npm run build:save-hange && vite build",
    "build:save-hange": "vite build --config vite.save-hange.config.ts",
    "preview": "vite preview",
    "sync:archive": "node scripts/sync-archive.mjs",
    "test": "vitest",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "verify:secrets": "node scripts/verify-no-secrets.mjs",
    "verify:levels": "node scripts/verify-save-hange-levels.ts",
    "verify:backend-schema": "node scripts/verify-backend-schema.mjs && node scripts/verify-content-pipeline.mjs && node scripts/verify-content-access.mjs",
    "prebuild": "node scripts/generate-admin-pixiv.mjs"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@cloudbase/js-sdk": "^3.9.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-pinch-zoom-pan": "^1.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "jsdom": "^24.1.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  }
}
