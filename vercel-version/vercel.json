{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "routes": [
    {
      "src": "^/sw\\.js$",
      "has": [{ "type": "host", "value": "admin.levihan.asia" }],
      "dest": "/admin/sw-kill.js",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "admin.levihan.asia" }],
      "dest": "/admin/index.html",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    },
    {
      "src": "^/pixiv-artists\\.js$",
      "has": [{ "type": "host", "value": "admin.levihan.asia" }],
      "dest": "/admin/pixiv-artists.js"
    },
    {
      "src": "^/admin/(.*)$",
      "has": [{ "type": "host", "value": "admin.levihan.asia" }],
      "dest": "/admin/$1",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "admin.levihan.asia" }],
      "dest": "/admin/$1"
    },
    {
      "src": "^/admin(?:/.*)?$",
      "has": [{ "type": "host", "value": "www.levihan.asia" }],
      "dest": "https://admin.levihan.asia/admin/index.html",
      "statusCode": 308
    },
    {
      "src": "^/admin(?:/.*)?$",
      "has": [{ "type": "host", "value": "levihan.asia" }],
      "dest": "https://admin.levihan.asia/admin/index.html",
      "statusCode": 308
    },
    { "src": "^/comics/?$", "dest": "/?tab=resources", "statusCode": 308 },
    {
      "src": "^/manifest\\.webmanifest$",
      "headers": { "Content-Type": "application/manifest+json" },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" },
      "continue": true
    },
    { "handle": "filesystem" }
  ]
}
