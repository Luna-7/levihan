{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "levihan-tudou-d0g7jivue1ccc4a35",
  "functionRoot": "functions",
  "functions": [
    {
      "name": "admin-upload",
      "type": "Event",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 30,
      "memorySize": 256,
      "description": "利韩土豆仓 · 同人本管理员上传通道（口令鉴权 + COS 读写 + 归档写入）",
      "installDependency": true,
      "envVariables": {
        "ADMIN_PASSWORD": "{{env.ADMIN_PASSWORD}}",
        "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}",
        "COS_BUCKET": "levihan-1325571558",
        "COS_REGION": "ap-nanjing",
        "ALLOWED_ORIGINS": "https://levihan-tudou-d0g7jivue1ccc4a35-1325571558.tcloudbaseapp.com,http://localhost:5173,http://localhost:4173,https://admin.levihan.asia,https://www.levihan.asia,https://levihan.asia"
      }
    },
    {
      "name": "registerWithPassword",
      "type": "Event",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 128,
      "description": "开放注册：昵称 + 密码，写 PG 并签发自定义登录票据（HTTP 访问服务暴露）",
      "installDependency": true,
      "envVariables": { "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}" }
    },
    {
      "name": "loginWithPassword",
      "type": "Event",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 128,
      "description": "昵称 + 密码登录：校验 scrypt 散列并签发自定义登录票据（HTTP 访问服务暴露）",
      "installDependency": true,
      "envVariables": { "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}" }
    },
    {
      "name": "getUserAccount",
      "type": "Event",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 128,
      "description": "读取登录用户档案（昵称 / 角色 / 加入时间）",
      "installDependency": true,
      "envVariables": { "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}" }
    },
    {
      "name": "updateNickname",
      "type": "Event",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 128,
      "description": "登录成员修改统一昵称",
      "installDependency": true,
      "envVariables": { "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}" }
    },
    {
      "name": "submitGameScore",
      "type": "Event",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 128,
      "description": "提交小游戏成绩并折算积分（需登录，服务端重算，每人每游戏每日 30 次）",
      "installDependency": true,
      "envVariables": { "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}" }
    },
    {
      "name": "getGameLeaderboard",
      "type": "Event",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 128,
      "description": "读取头号玩家排行榜（公开可读，游客无需登录）",
      "installDependency": true,
      "envVariables": { "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}" }
    }
  ]
}
