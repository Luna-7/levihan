{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sprites": "python3 scripts/generate-ui-sprite.py",
    "build:lab": "python3 scripts/build-ladder-lab.py",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:save-hange": "vite --config vite.save-hange.config.ts --port=3001",
    "build": "npm run build:save-hange && vite build",
    "build:save-hange": "vite build --config vite.save-hange.config.ts",
    "preview": "vite preview",
    "sync:archive": "node scripts/sync-archive.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "check:admin": "node scripts/check-admin-inline.cjs",
    "test:auth": "node --test tests/auth-functions.test.cjs",
    "test:admin": "node --test tests/admin-pdf-expand-contract.test.cjs tests/admin-vendor-local.test.cjs",
    "test:vault": "node --test tests/vault-multipart-contract.test.cjs",
    "test:secure": "node --test tests/secure-vault.test.cjs tests/secure-pdf-merge.test.cjs tests/secure-pdf-compress.test.cjs tests/secure-compress-ladder.test.cjs tests/secure-reader-interop.test.cjs tests/secure-cover-contract.test.cjs tests/secure-canvas-safety.test.cjs tests/secure-reader-no-cdn.test.cjs",
    "test:ui": "node --test tests/user-entry-credentials.test.cjs",
    "test": "npm run check:admin && npm run test:admin && npm run test:vault && npm run test:secure && npm run test:ui && npm run lint && npm run test:auth",
    "verify:levels": "node scripts/verify-save-hange-levels.ts",
    "prebuild": "node scripts/generate-admin-pixiv.mjs"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@cloudbase/js-sdk": "^3.9.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "^3.11.174",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-pinch-zoom-pan": "^1.4.5"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.0",
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
