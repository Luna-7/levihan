# Password for doujinshi archive access authentication
DOUJIN_PASSWORD=

# Password supplied only to the remote admin-channel/UI/screenshot checks (never commit a value)
ADMIN_TEST_PASSWORD=

# Browser-readable CSRF cookie name. Keep this identical to the app-api
# CSRF_COOKIE_NAME deployment value (defaults to lv_csrf on both sides).
VITE_CSRF_COOKIE_NAME=lv_csrf
